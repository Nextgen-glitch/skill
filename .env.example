# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- The brain (Tier 1) ---
# Anthropic API key for the model. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Voice (Tier 3) ---
# Deepgram speech-to-text. https://console.deepgram.com/
DEEPGRAM_API_KEY=
# ElevenLabs text-to-speech. https://elevenlabs.io/
ELEVENLABS_API_KEY=

# --- Real services (wired stub-first, post-baseline) ---
# Credentials for Gmail / Google Calendar / Vibe Prospecting go here when wired.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# VIBE_PROSPECTING_API_KEY=
