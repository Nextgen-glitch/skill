# Anthropic (required — agent intelligence)
ANTHROPIC_API_KEY=sk-ant-...

# Shopify Admin API
# Create a custom app in your Shopify admin → Apps → Develop apps
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10

# Facebook / Instagram (Meta Graph API)
# Create an app at developers.facebook.com, add Messenger + Instagram Graph products
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=delix-verify-token-change-me

# TikTok
# Get credentials from developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Mode: "mock" runs without external API calls (for local dev),
# "live" hits the real APIs (requires all credentials above).
INTEGRATION_MODE=mock
